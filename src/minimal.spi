///- --package . --timeout 900000
:# minimal static =
    :< testing

:< charset
:< syntax
:< derivative
:< dfa

:| block =
    | DeadBlock
    | Block : i32

:~ ^ bool_at (i : i32) (values : list bool) : bool =
    ?= values ?|
    | v :: rest => ? i = 0i32 ?> v |: bool_at (i - 1i32) rest
    | [] => !-

:= is_live (t : target) (live : list bool) : bool =
    ?= t ?|
    | Dead => !-
    | To s => bool_at (state_index s) live

:~ ^ live_after (d : dfa) (live : list bool) : list bool = live_rows d::rows live
:& :~ live_rows (rows : list row) (live : list bool) : list bool =
    ?= rows ?|
    | r :: rest => (r::accepting = Accepted || any_live r::next live) :: live_rows rest live
    | [] => []
:& :~ any_live (next : list target) (live : list bool) : bool =
    ?= next ?|
    | t :: rest => is_live t live || any_live rest live
    | [] => !-

:~ ^ live_fixpoint (d : dfa) (live : list bool) : list bool =
    := next = live_after d live
    ? next = live ?> live |: live_fixpoint d next

:~ ^ falses (n : i32) : list bool = ? n <= 0i32 ?> [] |: !- :: falses (n - 1i32)

:= live_states (d : dfa) : list bool = live_fixpoint d (falses (state_count d))

:~ ^ block_at (i : i32) (blocks : list block) : block =
    ?= blocks ?|
    | b :: rest => ? i = 0i32 ?> b |: block_at (i - 1i32) rest
    | [] => DeadBlock

:= block_of (t : target) (blocks : list block) : block =
    ?= t ?|
    | Dead => DeadBlock
    | To s => block_at (state_index s) blocks

:~ ^ blocks_of_targets (next : list target) (blocks : list block) : list block =
    ?= next ?|
    | t :: rest => block_of t blocks :: blocks_of_targets rest blocks
    | [] => []

:== signature = { own : block; moves : list block }

:| found =
    | FoundAt : i32
    | Missing

:~ ^ signature_id (s : signature) (seen : list (signature * i32)) : found =
    ?= seen ?|
    | (k, id) :: rest => ? k = s ?> FoundAt id |: signature_id s rest
    | [] => Missing

:== refined = { blocks : list block; seen : list (signature * i32); count : i32 }

:~ assign (s : signature) (acc : refined) : refined =
    ?= signature_id s acc::seen ?|
    | FoundAt known => { acc ?| blocks = Block known :: acc::blocks }
    | Missing => { blocks = Block acc::count :: acc::blocks; seen = (s, acc::count) :: acc::seen; count = acc::count + 1i32 }

:~ ^ refine_rows (rows : list row) (index : i32) (blocks : list block) (acc : refined) : refined =
    ?= rows ?|
    | r :: rest =>
        ?= block_at index blocks ?|
        | DeadBlock => refine_rows rest (index + 1i32) blocks { acc ?| blocks = DeadBlock :: acc::blocks }
        | own => refine_rows rest (index + 1i32) blocks (assign { own = own; moves = blocks_of_targets r::next blocks } acc)
    | [] => { acc ?| blocks = listm::rev acc::blocks }

:~ ^ initial_blocks (rows : list row) (live : list bool) (index : i32) : list block =
    ?= rows ?|
    | r :: rest =>
        := b = ? bool_at index live = !- ?> DeadBlock |? r::accepting = Accepted ?> Block 1i32 |: Block 0i32
        b :: initial_blocks rest live (index + 1i32)
    | [] => []

:~ ^ has_id (id : i32) (seen : list i32) : bool =
    ?= seen ?|
    | x :: rest => x = id || has_id id rest
    | [] => !-

:~ ^ count_blocks (blocks : list block) (seen : list i32) (n : i32) : i32 =
    ?= blocks ?|
    | b :: rest =>
        ?= b ?|
        | DeadBlock => count_blocks rest seen n
        | Block id => ? has_id id seen ?> count_blocks rest seen n |: count_blocks rest (id :: seen) (n + 1i32)
    | [] => n

:~ ^ moore (rows : list row) (blocks : list block) (count : i32) : list block * i32 =
    := next = refine_rows rows 0i32 blocks { blocks = []; seen = []; count = 0i32 }
    ? next::count = count ?> next::blocks, next::count |: moore rows next::blocks next::count

:~ ^ representative (id : i32) (blocks : list block) (index : i32) : found =
    ?= blocks ?|
    | b :: rest => ? b = Block id ?> FoundAt index |: representative id rest (index + 1i32)
    | [] => Missing

:= index_of_found (f : found) : i32 =
    ?= f ?|
    | FoundAt i => i
    | Missing => 0i32

:~ ^ re_nth (i : i32) (regexes : list re) : re =
    ?= regexes ?|
    | r :: rest => ? i = 0i32 ?> r |: re_nth (i - 1i32) rest
    | [] => Nothing

:= block_target (b : block) : target =
    ?= b ?|
    | DeadBlock => Dead
    | Block id => To (state id)

:~ ^ block_targets (bs : list block) : list target =
    ?= bs ?|
    | b :: rest => block_target b :: block_targets rest
    | [] => []

:~ ^ quotient_rows (d : dfa) (blocks : list block) (id : i32) (count : i32) (rows : list row) (regexes : list re) : list row * list re =
    ? id < 0i32 ?> rows, regexes
    |:
        := at = index_of_found (representative id blocks 0i32)
        := r = row_at at d::rows
        := row = { accepting = r::accepting; next = block_targets (blocks_of_targets r::next blocks) }
        quotient_rows d blocks (id - 1i32) count (row :: rows) (re_nth at d::regexes :: regexes)

:~ minimize (d : dfa) : dfa =
    := blocks0 = initial_blocks d::rows (live_states d) 0i32
    := blocks, count = moore d::rows blocks0 (count_blocks blocks0 [] 0i32)
    := rows, regexes = quotient_rows d blocks (count - 1i32) count [] []
    { classes = d::classes; start = block_target (block_of d::start blocks); rows = rows; regexes = regexes }

:= minimal_size (b : built) : size =
    ?= b ?|
    | Built d => States (state_count (minimize d))
    | StateCapReached n => Refused n

///> rust
///> gleam
:# zero_runs_minimize_to_two_live_states =
    := ~r = zero_runs ()
    minimal_size (build r) |> _assert_eq (States 2i32)

///> rust
///> gleam
:# the_fourth_symbol_from_the_end_needs_sixteen_states =
    := ~r = fourth_from_end ()
    minimal_size (build r) |> _assert_eq (States 16i32)

///> rust
///> gleam
:# an_empty_intersection_minimizes_to_no_live_state =
    := ~r = both (ends_in_zero ()) (negate (ends_in_zero ()))
    minimal_size (build r) |> _assert_eq (States 0i32)
