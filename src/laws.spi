///- --package . --timeout 900000
:# laws static =
    :< testing

:< regex_charset
:< regex_syntax
:< regex_nullable
:< regex_derivative
:< regex_language

:~ ^ normalize (r : re) : re =
    ?= r ?|
    | Seq (a, b) => seq (normalize a) (normalize b)
    | Alt (a, b) => alt (normalize a) (normalize b)
    | And (a, b) => both (normalize a) (normalize b)
    | _ => normalize_unary r

:& :~ normalize_unary (r : re) : re =
    ?= r ?|
    | Not a => negate (normalize a)
    | Star a => star (normalize a)
    | Repeat (a, low, up) => repeat (normalize a) low up
    | other => other

:= atoms () : list re = [ Nothing; Epsilon; zero (); one () ]

:~ ^ unary_of (xs : list re) : list re =
    ?= xs ?|
    | x :: rest => Not x :: Star x :: unary_of rest
    | [] => []

:~ ^ pairs_with (a : re) (bs : list re) : list re =
    ?= bs ?|
    | b :: rest => Seq (a, b) :: Alt (a, b) :: And (a, b) :: pairs_with a rest
    | [] => []

:~ ^ binary_of (xs : list re) (ys : list re) : list re =
    ?= xs ?|
    | x :: rest => listm::append (pairs_with x ys) (binary_of rest ys)
    | [] => []

:= deeper (xs : list re) : list re = listm::append (unary_of xs) (binary_of xs xs)

:= depth_one () : list re = listm::append (atoms ()) (deeper (atoms ()))

:= depth_two () : list re = listm::append (depth_one ()) (deeper (depth_one ()))

:= short_words () : list (list u32) =
    [ []; [ 48u32 ]; [ 49u32 ]; [ 48u32; 48u32 ]; [ 48u32; 49u32 ]; [ 49u32; 48u32 ]; [ 49u32; 49u32 ] ]

:| law =
    | Constructors
    | Idempotence
    | Nullability
    | Remainder
    | Brzozowski

:| laws_verdict =
    | AllHold : i32
    | Broken : law * re * list u32

:~ remainder_law (r : re) (n : re) (c : u32) (rest : list u32) (l : verdict) (checked : i32) : laws_verdict =
    ? language_answer (derive c n) rest <> l ?> Broken (Remainder, r, c :: rest) |: AllHold (checked + 3i32)

:~ nullability_law (r : re) (n : re) (l : verdict) (checked : i32) : laws_verdict =
    ? verdict_of (nullable n) <> l ?> Broken (Nullability, r, []) |: AllHold (checked + 3i32)

:~ front_broken (r : re) (n : re) (w : list u32) (l : verdict) : option laws_verdict =
    ? language_answer n w <> l
    ?> Some (Broken (Constructors, r, w))
    |? matches r w <> l
    ?> Some (Broken (Brzozowski, r, w))
    |: None

:~ tail_laws (r : re) (n : re) (w : list u32) (l : verdict) (checked : i32) : laws_verdict =
    ?= w ?|
    | c :: rest => remainder_law r n c rest l checked
    | [] => nullability_law r n l checked

:~ word_laws (r : re) (n : re) (w : list u32) (checked : i32) : laws_verdict =
    := l = language_answer r w
    ?= front_broken r n w l ?|
    | Some b => b
    | None => tail_laws r n w l checked

:~ ^ words_hold (r : re) (n : re) (ws : list (list u32)) (checked : i32) : laws_verdict =
    ?= ws ?|
    | w :: rest =>
        ?= word_laws r n w checked ?|
        | AllHold k => words_hold r n rest k
        | broken => broken
    | [] => AllHold checked

:~ re_laws (r : re) (ws : list (list u32)) (checked : i32) : laws_verdict =
    := n = normalize r
    ? same_re (normalize n) n |> not ?> Broken (Idempotence, r, []) |: words_hold r n ws (checked + 1i32)

:~ ^ laws_hold (rs : list re) (ws : list (list u32)) (checked : i32) : laws_verdict =
    ?= rs ?|
    | r :: rest =>
        ?= re_laws r ws checked ?|
        | AllHold k => laws_hold rest ws k
        | broken => broken
    | [] => AllHold checked

///> rust
///> gleam
:# every_regex_of_depth_one_keeps_all_five_laws_on_every_short_word =
    laws_hold (depth_one ()) (short_words ()) 0i32 |> _assert_eq (AllHold 1320i32)

///> rust
:# every_regex_of_depth_two_keeps_all_five_laws_on_every_short_word =
    laws_hold (depth_two ()) (short_words ()) 0i32 |> _assert_eq (AllHold 241560i32)
