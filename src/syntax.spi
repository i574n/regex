///- --package . --timeout 900000
:# syntax static =
    :< testing

:< charset

:| upper =
    | Bounded : u32
    | Unbounded

:| ^ re =
    | Nothing
    | Epsilon
    | Set : char_set normal
    | Seq : re * re
    | Alt : re * re
    | And : re * re
    | Not : re
    | Star : re
    | Repeat : re * u32 * upper

:= rank (r : re) : u32 =
    ?= r ?|
    | Nothing => 0u32
    | Epsilon => 1u32
    | Set _ => 2u32
    | Seq _ => 3u32
    | Alt _ => 4u32
    | And _ => 5u32
    | Not _ => 6u32
    | Star _ => 7u32
    | Repeat _ => 8u32

:= order_upper (a : upper) (b : upper) : order =
    ?= a ?|
    | Bounded x => ?= b ?| Bounded y => order_u32 x y | Unbounded => Before
    | Unbounded => ?= b ?| Bounded _ => After | Unbounded => Same

:= then_order (first : order) (next : () -> order) : order =
    ?= first ?|
    | Same => next ()
    | o => o

:~ ^ order_re (a : re) (b : re) : order = then_order (order_u32 (rank a) (rank b)) (\ () => order_same a b)
:& :~ order_same (a : re) (b : re) : order =
    ?= a ?|
    | Set x => ?= b ?| Set y => order_sets x y | _ => Same
    | Seq (x, y) => ?= b ?| Seq (u, v) => order_two x y u v | _ => Same
    | Alt (x, y) => ?= b ?| Alt (u, v) => order_two x y u v | _ => Same
    | And (x, y) => ?= b ?| And (u, v) => order_two x y u v | _ => Same
    | Not x => ?= b ?| Not u => order_re x u | _ => Same
    | Star x => ?= b ?| Star u => order_re x u | _ => Same
    | Repeat (x, low, up) => ?= b ?| Repeat (u, l, p) => order_repeat x low up u l p | _ => Same
    | _ => Same
:& :~ order_two (x : re) (y : re) (u : re) (v : re) : order = then_order (order_re x u) (\ () => order_re y v)
:& :~ order_repeat (x : re) (low : u32) (up : upper) (u : re) (l : u32) (p : upper) : order =
    then_order (order_u32 low l) (\ () => then_order (order_upper up p) (\ () => order_re x u))

:~ same_re (a : re) (b : re) : bool =
    ?= order_re a b ?|
    | Same => !+
    | _ => !-

:= is_nothing (r : re) : bool =
    ?= r ?|
    | Nothing => !+
    | _ => !-

:= is_universal (r : re) : bool =
    ?= r ?|
    | Not inner => is_nothing inner
    | _ => !-

:= universal () : re = Not Nothing

:~ ^ seq (a : re) (b : re) : re =
    ?= a ?|
    | Nothing => Nothing
    | Epsilon => b
    | Seq (x, y) => seq x (seq y b)
    | _ =>
        ?= b ?|
        | Nothing => Nothing
        | Epsilon => a
        | _ => Seq (a, b)

:~ ^ insert_leaf (leaf : re) (sorted : list re) : list re =
    ?= sorted ?|
    | head :: rest =>
        ?= order_re leaf head ?|
        | Same => sorted
        | Before => leaf :: sorted
        | After => head :: insert_leaf leaf rest
    | [] => [ leaf ]

:~ ^ alt_leaves (r : re) (sorted : list re) : list re =
    ?= r ?|
    | Alt (x, y) => alt_leaves x (alt_leaves y sorted)
    | Nothing => sorted
    | _ => insert_leaf r sorted

:~ ^ and_leaves (r : re) (sorted : list re) : list re =
    ?= r ?|
    | And (x, y) => and_leaves x (and_leaves y sorted)
    | _ => ? is_universal r ?> sorted |: insert_leaf r sorted

:~ ^ alt_of (leaves : list re) : re =
    ?= leaves ?|
    | [] => Nothing
    | leaf :: [] => leaf
    | leaf :: rest => Alt (leaf, alt_of rest)

:~ ^ and_of (leaves : list re) : re =
    ?= leaves ?|
    | [] => universal ()
    | leaf :: [] => leaf
    | leaf :: rest => And (leaf, and_of rest)

:~ alt (a : re) (b : re) : re =
    ? is_universal a || is_universal b ?> universal () |: alt_of (alt_leaves a (alt_leaves b []))

:~ both (a : re) (b : re) : re =
    ? is_nothing a || is_nothing b ?> Nothing |: and_of (and_leaves a (and_leaves b []))

:~ negate (a : re) : re =
    ?= a ?|
    | Not inner => inner
    | _ => Not a

:~ star (a : re) : re =
    ?= a ?|
    | Nothing => Epsilon
    | Epsilon => Epsilon
    | Star _ => a
    | _ => Star a

:= one_less (n : u32) : u32 = ? n = 0u32 ?> 0u32 |: n - 1u32

:= upper_less (up : upper) : upper =
    ?= up ?|
    | Bounded n => Bounded (one_less n)
    | Unbounded => Unbounded

:= repeat_atom (a : re) (low : u32) (up : upper) : re =
    ?= a ?|
    | Nothing => ? low = 0u32 ?> Epsilon |: Nothing
    | Epsilon => Epsilon
    | _ => Repeat (a, low, up)

:~ repeat (a : re) (low : u32) (up : upper) : re =
    ?= up ?|
    | Bounded n =>
        ? n = 0u32 ?> Epsilon
        |? n < low ?> Nothing
        |? low = 1u32 && n = 1u32 ?> a
        |: repeat_atom a low up
    | Unbounded => ? low = 0u32 ?> star a |: repeat_atom a low up

:= set (s : char_set normal) : re = ? is_empty s ?> Nothing |: Set s

:= code (c : u32) : re = Set (single c)

:~ ^ word (codes : list u32) : re =
    ?= codes ?|
    | c :: rest => seq (code c) (word rest)
    | [] => Epsilon

:= optional (a : re) : re = alt Epsilon a

:= plus (a : re) : re = seq a (star a)

:= any_code () : re = Set (everything ())

:= zero () : re = code 48u32

:= one () : re = code 49u32

:= bit () : re = alt (zero ()) (one ())

///> rust
///> gleam
:# alternation_is_sorted_and_deduplicated =
    same_re (alt (one ()) (alt (zero ()) (one ()))) (alt (zero ()) (one ())) |> _assert_eq !+

///> rust
///> gleam
:# nothing_is_the_unit_of_alternation_and_absorbs_sequence =
    (same_re (alt Nothing (bit ())) (bit ()), same_re (seq (bit ()) Nothing) Nothing) |> _assert_eq (!+, !+)

///> rust
///> gleam
:# sequence_nests_to_the_right =
    same_re (seq (seq (zero ()) (one ())) (zero ())) (Seq (zero (), Seq (one (), zero ()))) |> _assert_eq !+

///> rust
///> gleam
:# a_double_negation_and_a_starred_star_collapse =
    (same_re (negate (negate (bit ()))) (bit ()), same_re (star (star (bit ()))) (star (bit ()))) |> _assert_eq (!+, !+)

///> rust
///> gleam
:# counted_repetition_stays_one_node =
    rank (repeat (bit ()) 1u32 (Bounded 1000u32)) |> _assert_eq 8u32

///> rust
///> gleam
:# degenerate_counts_simplify =
    (same_re (repeat (bit ()) 0u32 (Bounded 0u32)) Epsilon, same_re (repeat (bit ()) 1u32 (Bounded 1u32)) (bit ()), same_re (repeat (bit ()) 3u32 (Bounded 2u32)) Nothing) |> _assert_eq (!+, !+, !+)

///> rust
///> gleam
:# the_universal_language_absorbs_alternation_and_is_the_unit_of_intersection =
    (is_universal (alt (bit ()) (universal ())), same_re (both (universal ()) (bit ())) (bit ())) |> _assert_eq (!+, !+)
