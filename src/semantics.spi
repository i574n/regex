///- --package . --timeout 900000
:# semantics static =
    :< testing

:< charset
:< syntax
:< derivative
:< language
:< dfa
:< minimal
:< certificate
:< partial
:< agreement

:~ ^ oracle_from (r : re) (eager : built) (m : dfa) (salt : u32) (turn : u32) (n : u32) (checked : i32) : agreement =
    ? turn >= n ?> Agree checked
    |:
        := w = random_word salt turn (lows_of (classes_of r))
        := a = answers_of r eager m w
        ? agree a && language_answer r w = a::brzozowski ?> oracle_from r eager m salt (turn + 1u32) n (checked + 1i32) |: Disagree (w, a)

:~ ^ oracle_all (salt : u32) (n : u32) (patterns : list re) (total : i32) : agreement =
    ?= patterns ?|
    | r :: rest =>
        ?= oracle_from r (build r) (minimal_of r) salt 0u32 n 0i32 ?|
        | Agree k => oracle_all salt n rest (total + k)
        | d => d
    | [] => Agree total

:~ ^ backtrackable (r : re) : bool =
    ?= r ?|
    | And _ => !-
    | Not _ => !-
    | Seq (a, b) => backtrackable a && backtrackable b
    | Alt (a, b) => backtrackable a && backtrackable b
    | Star a => backtrackable a
    | Repeat (a, _, _) => backtrackable a
    | _ => !+

:~ ^ bt (r : re) (t : subject) (p : i32) (k : i32 -> bool) : bool =
    ?= r ?|
    | Nothing => !-
    | Epsilon => k p
    | Set s => p < t::size && contains (code_at t::codes p) s && k (p + 1i32)
    | Seq (a, b) => bt a t p (\ q => bt b t q k)
    | Alt (a, b) => bt a t p k || bt b t p k
    | Star a => bt_star a t p k
    | Repeat (a, low, up) => bt_repeat a t low up p k
    | _ => !-
:& :~ bt_star (a : re) (t : subject) (p : i32) (k : i32 -> bool) : bool =
    bt a t p (\ q => q > p && bt_star a t q k) || k p
:& :~ bt_repeat (a : re) (t : subject) (low : u32) (up : upper) (p : i32) (k : i32 -> bool) : bool =
    ? low > 0u32 ?> bt a t p (\ q => bt_repeat a t (low - 1u32) (upper_less up) q k)
    |:
        ?= up ?|
        | Unbounded => bt_star a t p k
        | Bounded n => ? n = 0u32 ?> k p |: bt a t p (\ q => q > p && bt_repeat a t 0u32 (Bounded (n - 1u32)) q k) || k p

:! by_language = ()
:! by_backtracking = ()

:| ^ oracle_verdict kind =
    | LanguageVerdict :: verdict -> oracle_verdict by_language
    | BacktrackingVerdict :: verdict -> oracle_verdict by_backtracking

:| backtracking_reach =
    | Reached : oracle_verdict by_backtracking
    | OutsideFragment

:= verdict_of_oracle \* k. (v : oracle_verdict k) : verdict =
    ?= v ?|
    | LanguageVerdict x => x
    | BacktrackingVerdict x => x

:= backtracking_answer (r : re) (codes : list u32) : backtracking_reach =
    ? backtrackable r |> not ?> OutsideFragment
    |:
        := t = { codes = codes; size = length_of codes 0i32 }
        Reached (BacktrackingVerdict (verdict_of (bt r t 0i32 (\ q => q = t::size))))

:= reached_verdict (x : backtracking_reach) : option verdict =
    ?= x ?|
    | Reached v => Some (verdict_of_oracle v)
    | OutsideFragment => None

:= oracles_agree (l : oracle_verdict by_language) (b : oracle_verdict by_backtracking) : bool = verdict_of_oracle l = verdict_of_oracle b

:| oracle_agreement =
    | OraclesAgree : i32
    | OraclesDiffer : list u32

:~ ^ oracles_from (r : re) (salt : u32) (turn : u32) (n : u32) (checked : i32) : oracle_agreement =
    ? turn >= n ?> OraclesAgree checked
    |:
        := w = random_word salt turn (lows_of (classes_of r))
        ?= backtracking_answer r w ?|
        | Reached b => ? oracles_agree (LanguageVerdict (language_answer r w)) b ?> oracles_from r salt (turn + 1u32) n (checked + 1i32) |: OraclesDiffer w
        | OutsideFragment => oracles_from r salt (turn + 1u32) n checked

:~ ^ oracles_all (salt : u32) (n : u32) (patterns : list re) (total : i32) : oracle_agreement =
    ?= patterns ?|
    | r :: rest =>
        ?= oracles_from r salt 0u32 n 0i32 ?|
        | OraclesAgree k => oracles_all salt n rest (total + k)
        | d => d
    | [] => OraclesAgree total

:~ ^ zeros (n : i32) : list u32 = ? n <= 0i32 ?> [] |: 48u32 :: zeros (n - 1i32)

///> rust
///> gleam
:# the_backtracking_baseline_agrees_with_the_language_oracle_on_the_and_not_free_corpus =
    := ~salt = 20261101u32
    oracles_all salt 40u32 (curated ()) 0i32 |> _assert_eq (OraclesAgree 200i32)

///> rust
///> gleam
:# the_redos_shape_still_gets_the_right_answer_by_backtracking =
    := ~r = seq (star (alt (zero ()) (seq (zero ()) (zero ())))) (one ())
    := w = zeros 12i32
    (reached_verdict (backtracking_answer r w), language_answer r w, reached_verdict (backtracking_answer r (listm::append w [ 49u32 ]))) |> _assert_eq (Some Rejected, Rejected, Some Accepted)

///> rust
:# an_oracle_is_never_compared_with_itself fails "Unification failure" =
    oracles_agree (LanguageVerdict Accepted) (LanguageVerdict Accepted)

///> rust
///> gleam
:# the_language_oracle_agrees_with_every_engine_on_the_seeded_corpus =
    := ~salt = 20261101u32
    oracle_all salt 40u32 (curated ()) 0i32 |> _assert_eq (Agree 240i32)
