///- --package . --timeout 900000
:# witness static =
    :< testing

:< regex_charset
:< regex_syntax
:< regex_nullable
:< regex_derivative
:< laws
:< fin_vector

:| seq_branch =
    | NullableLeft
    | SolidLeft

:= seq_branch_of (a : re) : seq_branch = ? nullable a ?> NullableLeft |: SolidLeft

:| leaf =
    | NothingLeaf
    | EpsilonLeaf
    | SetLeaf : char_set normal

:| binary =
    | AltOf
    | AndOf

:| unary =
    | NotOf
    | StarOf
    | RepeatOf : u32 * upper

:| ^ step_proof =
    | ProofLeaf : u32 * leaf
    | ProofSeq : u32 * seq_branch * step_proof * step_proof
    | ProofPair : u32 * binary * step_proof * step_proof
    | ProofOne : u32 * unary * step_proof

:= leaf_source (l : leaf) : re =
    ?= l ?|
    | NothingLeaf => Nothing
    | EpsilonLeaf => Epsilon
    | SetLeaf s => Set s

:= pair_source (k : binary) (a : re) (b : re) : re =
    ?= k ?|
    | AltOf => Alt (a, b)
    | AndOf => And (a, b)

:= one_source (k : unary) (a : re) : re =
    ?= k ?|
    | NotOf => Not a
    | StarOf => Star a
    | RepeatOf (low, up) => Repeat (a, low, up)

:~ ^ proof_source (p : step_proof) : re =
    ?= p ?|
    | ProofLeaf (_, l) => leaf_source l
    | ProofSeq (_, _, a, b) => Seq (proof_source a, proof_source b)
    | _ => source_rest p

:& :~ source_rest (p : step_proof) : re =
    ?= p ?|
    | ProofPair (_, k, a, b) => pair_source k (proof_source a) (proof_source b)
    | ProofOne (_, k, a) => one_source k (proof_source a)
    | _ => Nothing

:= proof_symbol (p : step_proof) : u32 =
    ?= p ?|
    | ProofLeaf (c, _) => c
    | ProofSeq (c, _, _, _) => c
    | ProofPair (c, _, _, _) => c
    | ProofOne (c, _, _) => c

:= leaf_of (r : re) : leaf =
    ?= r ?|
    | Epsilon => EpsilonLeaf
    | Set s => SetLeaf s
    | _ => NothingLeaf

:~ ^ proof_of (c : u32) (r : re) : step_proof =
    ?= r ?|
    | Seq (a, b) => ProofSeq (c, seq_branch_of a, proof_of c a, proof_of c b)
    | _ => proof_pair c r

:& :~ proof_pair (c : u32) (r : re) : step_proof =
    ?= r ?|
    | Alt (a, b) => ProofPair (c, AltOf, proof_of c a, proof_of c b)
    | And (a, b) => ProofPair (c, AndOf, proof_of c a, proof_of c b)
    | _ => proof_one c r

:& :~ proof_one (c : u32) (r : re) : step_proof =
    ?= r ?|
    | Not a => ProofOne (c, NotOf, proof_of c a)
    | Star a => ProofOne (c, StarOf, proof_of c a)
    | Repeat (a, l, u) => ProofOne (c, RepeatOf (l, u), proof_of c a)
    | _ => ProofLeaf (c, leaf_of r)

:= leaf_candidate (c : u32) (l : leaf) : re =
    ?= l ?|
    | SetLeaf s => ? contains c s ?> Epsilon |: Nothing
    | _ => Nothing

:~ ^ candidate (p : step_proof) : re =
    ?= p ?|
    | ProofLeaf (c, l) => leaf_candidate c l
    | ProofSeq (_, s, a, b) => seq_candidate s a b
    | ProofPair (_, k, a, b) => pair_source k (candidate a) (candidate b)
    | ProofOne (_, k, a) => one_candidate k a

:& :~ seq_candidate (branch : seq_branch) (a : step_proof) (b : step_proof) : re =
    := first = Seq (candidate a, proof_source b)
    ?= branch ?|
    | NullableLeft => Alt (first, candidate b)
    | SolidLeft => first

:& :~ one_candidate (k : unary) (a : step_proof) : re =
    ?= k ?|
    | NotOf => Not (candidate a)
    | StarOf => Seq (candidate a, Star (proof_source a))
    | RepeatOf (low, up) => repeat_candidate low up a

:& :~ repeat_candidate (low : u32) (up : upper) (a : step_proof) : re =
    ?= up ?|
    | Bounded n ?& n = 0u32 => Nothing
    | _ => Seq (candidate a, Repeat (proof_source a, one_less low, upper_less up))

:~ ^ proof_valid (p : step_proof) : bool =
    := equation = same_re (normalize (candidate p)) (normalize (derive (proof_symbol p) (proof_source p)))
    equation && children_valid p

:& :~ children_valid (p : step_proof) : bool =
    := c = proof_symbol p
    ?= p ?|
    | ProofSeq (_, s, a, b) => seq_valid c s a b
    | ProofPair (_, _, a, b) => pair_valid c a b
    | ProofOne (_, _, a) => one_valid c a
    | ProofLeaf _ => !+

:& :~ seq_valid (c : u32) (s : seq_branch) (a : step_proof) (b : step_proof) : bool =
    s = seq_branch_of (proof_source a) && pair_valid c a b

:& :~ pair_valid (c : u32) (a : step_proof) (b : step_proof) : bool = one_valid c a && one_valid c b

:& :~ one_valid (c : u32) (a : step_proof) : bool = proof_symbol a = c && proof_valid a

:~ ^ valid_on (rs : list re) (c : u32) (n : i32) : i32 =
    ?= rs ?|
    | r :: rest => valid_on rest c (? proof_valid (proof_of c r) ?> n + 1i32 |: n)
    | [] => n

:= flipped_branch (p : step_proof) : step_proof =
    ?= p ?|
    | ProofSeq (c, NullableLeft, a, b) => ProofSeq (c, SolidLeft, a, b)
    | ProofSeq (c, SolidLeft, a, b) => ProofSeq (c, NullableLeft, a, b)
    | other => other

:= star_zero_then_one () : re = Seq (Star (zero ()), one ())

:= mixed_symbols () : step_proof = ProofPair (48u32, AltOf, proof_of 49u32 (zero ()), proof_of 48u32 (one ()))

///> rust
///> gleam
:# every_regex_of_depth_one_has_a_valid_step_proof_on_both_symbols =
    (valid_on (depth_one ()) 48u32 0i32, valid_on (depth_one ()) 49u32 0i32) |> _assert_eq (60i32, 60i32)

///> rust
///> gleam
:# a_flipped_branch_or_a_mixed_symbol_proof_is_rejected =
    := p = proof_of 48u32 (star_zero_then_one ())
    (proof_valid p, proof_valid (flipped_branch p), proof_valid (mixed_symbols ())) |> _assert_eq (!+, !-, !-)

:== quotient_certificate c r = { cover : vector c (fin r); origin : vector r (fin c) }

:= ^ sections_from \* m c r. (cover : vector c (fin r)) (origins : vector m (fin c)) (k : i32) : bool =
    ?= origins ?|
    | VectorEnd => !+
    | VectorCons (o, rest) => fin_value (item o cover) = k && sections_from cover rest (k + 1i32)

:= certified \* c r. (q : quotient_certificate c r) : bool = sections_from q::cover q::origin 0i32

:== two = nat_succ (nat_succ nat_zero)

:== three = nat_succ two

:= merged_cover () : vector three (fin two) =
    VectorCons (FinFirst, VectorCons (FinNext FinFirst, VectorCons (FinNext FinFirst, VectorEnd)))

:= origins_of (second : fin three) : vector two (fin three) = VectorCons (FinFirst, VectorCons (second, VectorEnd))

///> rust
:# a_quotient_is_certified_when_every_representative_maps_back_to_itself =
    := good = { cover = merged_cover (); origin = origins_of (FinNext FinFirst) }
    (certified good, certified { good ?| origin = origins_of FinFirst }) |> _assert_eq (!+, !-)
