:= env_text (name : string) : string = $'std::rc::Rc::<str>::from(std::env::var(&*!name).unwrap_or_default())' : string

:~ print_line (text : string) : () = console.write_line text

:= os_name () : string = $'std::rc::Rc::<str>::from(std::env::consts::OS)' : string

:= arch_name () : string = $'std::rc::Rc::<str>::from(std::env::consts::ARCH)' : string

:! compiled_regex = $'regex::Regex'

:= compile_regex (pattern : string) : compiled_regex = $'regex::Regex::new(&*!pattern).unwrap()' : compiled_regex

:~ regex_is_match (r : compiled_regex) (text : string) : bool = $'!r.is_match(&*!text)' : bool
