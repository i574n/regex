:= elapsed_nanos () : u64 =
    $'{ static START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new(); START.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64 }' : u64

:= env_text (name : string) : string = $'std::rc::Rc::<str>::from(std::env::var(&*!name).unwrap_or_default())' : string

:~ ^ print_line (text : string) : () = console.write_line text
