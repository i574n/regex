:< regex_charset
:< regex_syntax
:< regex_derivative
:< regex_dfa
:< regex_minimal
:< regex_table
:< regex_certificate
:< partial
:< agreement
:< workloads
:< rx_external
:< rx_crate
:< regex_language
:< semantics
:< lazy
:< table_emit
:< sm'_operators
:< host


:== prepared =
    {
        regex : re
        eager : built
        quotient : dfa
        words : list (list u32)
        texts : list string
        table : table
        arrays : list (array_base u32)
        workload : workload
        salt : u32
        n : u32
    }


:~ ^ arrays_of (words : list (list u32)) : list (array_base u32) =
    ?= words ?|
    | w :: rest => array_of_codes w :: arrays_of rest
    | [] => []

:~ prepare (salt : u32) (n : u32) (w : workload) : prepared =
    := r = workload_regex w
    := words = workload_words salt n w r
    := c = certified_of r
    := m = automaton_dfa c
    {
        regex = r
        eager = build r
        quotient = m
        words = words
        texts = texts_of words
        table = table_of c
        arrays = arrays_of words
        workload = w
        salt = salt
        n = n
    }

:| arm =
    | BrzozowskiArm
    | AntimirovArm
    | EagerArm
    | MinimalArm
    | MinimalAgainArm
    | RegexCrateArm
    | TableArm
    | BacktrackingArm
    | LazyArm
    | LazyStoreArm

:~ answer (a : arm) (p : prepared) (w : list u32) : verdict =
    ?= a ?|
    | BrzozowskiArm => matches p::regex w
    | AntimirovArm => nfa_matches p::regex w
    | EagerArm => built_run p::eager w
    | MinimalArm => run_unchecked p::quotient w
    | MinimalAgainArm => run_unchecked p::quotient w
    | RegexCrateArm => run_unchecked p::quotient w
    | TableArm => run_unchecked p::quotient w
    | BacktrackingArm => run_unchecked p::quotient w
    | LazyArm =>
        := v, _ = run_lazy p::regex w
        v
    | LazyStoreArm =>
        := s, start = store_of p::regex 65536i32
        ?= run_in s start w ?|
        | Answered v => v
        | Overflowed => Rejected

:~ ^ accepted (a : arm) (p : prepared) (words : list (list u32)) (n : i32) : i32 =
    ?= words ?|
    | w :: rest => accepted a p rest (? answer a p w = Accepted ?> n + 1i32 |: n)
    | [] => n

:== sample = { arm : arm; nanos : u64; count : i32 }

:~ ^ table_accepted (p : prepared) (arrays : list (array_base u32)) (n : i32) : i32 =
    ?= arrays ?|
    | a :: rest => table_accepted p rest (? table_run p::table a = Accepted ?> n + 1i32 |: n)
    | [] => n

:~ ^ lazy_accepted (e : engine) (start : node) (words : list (list u32)) (c : cache) (n : i32) : i32 =
    ?= words ?|
    | w :: rest =>
        := v, c = run_from_node e start w c
        lazy_accepted e start rest c (? v = Accepted ?> n + 1i32 |: n)
    | [] => n

:~ ^ store_accepted (s : store) (start : i32) (words : list (list u32)) (n : i32) : i32 =
    ?= words ?|
    | w :: rest => store_accepted s start rest (? run_in s start w = Answered Accepted ?> n + 1i32 |: n)
    | [] => n

:= one_pass (a : arm) (p : prepared) : i32 =
    ?= a ?|
    | LazyArm =>
        := e, start, c = lazy_of p::regex
        lazy_accepted e start p::words c 0i32
    | LazyStoreArm =>
        := s, start = store_of p::regex 65536i32
        store_accepted s start p::words 0i32
    | TableArm => table_accepted p p::arrays 0i32
    | _ => accepted a p p::words 0i32

:~ ^ passes (a : arm) (p : prepared) (left : i32) (count : i32) : i32 =
    ? left <= 0i32 ?> count |: passes a p (left - 1i32) (one_pass a p)

:~ external_sample (a : arm) (p : prepared) : sample =
    := nanos, count =
        ? a = RegexCrateArm
        ?> crate_nanos (crate_pattern p::workload, p::texts)
        |: external_nanos (index_of_workload p::workload, p::words)
    { arm = a; nanos = nanos; count = count }

:~ timed (a : arm) (p : prepared) : sample =
    ? a = RegexCrateArm || a = BacktrackingArm ?> external_sample a p |:
    := before = date_time.monotonic_nanoseconds ()
    := count = passes a p 25i32 0i32
    { arm = a; nanos = date_time.monotonic_nanoseconds () - before; count = count }

:~ ^ run_arms (arms : list arm) (p : prepared) (acc : list sample) : list sample =
    ?= arms ?|
    | a :: rest => run_arms rest p (timed a p :: acc)
    | [] => acc

:~ ^ rotated (k : i32) (arms : list arm) : list arm =
    ? k <= 0i32
    ?> arms
    |:
        ?= arms ?|
        | a :: rest => rotated (k - 1i32) (listm::append rest [ a ])
        | [] => arms

:= all_arms () : list arm =
    [
        BrzozowskiArm
        AntimirovArm
        EagerArm
        MinimalArm
        MinimalAgainArm
        RegexCrateArm
        TableArm
        BacktrackingArm
        LazyArm
        LazyStoreArm
    ]

:~ ^ rounds (p : prepared) (k : i32) (n : i32) (acc : list (list sample)) : list (list sample) =
    ? k >= n ?> acc |: rounds p (k + 1i32) n (run_arms (rotated (k % 10i32) (all_arms ())) p [] :: acc)

:~ ^ sample_of (a : arm) (samples : list sample) : sample =
    ?= samples ?|
    | s :: rest => ? s::arm = a ?> s |: sample_of a rest
    | [] => { arm = a; nanos = 1u64; count = 0i32 }

:= ratio_in (a : arm) (round : list sample) : f64 =
    := top = sample_of a round
    := base = sample_of MinimalArm round
    (conv top::nanos : f64) / (conv (? base::nanos = 0u64 ?> 1u64 |: base::nanos) : f64)

:~ ^ ratios (a : arm) (all : list (list sample)) : list f64 =
    ?= all ?|
    | round :: rest => ratio_in a round :: ratios a rest
    | [] => []

:| time_verdict =
    | Ratio : bench_model::spread
    | Void : bench_model::spread

:= aa_band (aa : bench_model::spread) : time_verdict = ? aa::middle >= 0.95 && aa::middle <= 1.05 ?> Ratio aa |: Void aa

:~ ^ digits_of (n : i64) : string =
    := tail = sm'::obj_to_string (n % 10i64)
    ? n < 10i64 ?> tail |: digits_of (n / 10i64) ++# tail

:~ milli_text (x : f64) : string =
    := m = (conv (x * 1000.0 + 0.5) : i64)
    := frac = m % 1000i64
    := pad = ? frac < 10i64 ?> "00" |? frac < 100i64 ?> "0" |: ""
    digits_of (m / 1000i64) ++# "." ++# pad ++# digits_of frac

:= arm_name (a : arm) : string =
    ?= a ?|
    | BrzozowskiArm => "Brzozowski derivatives"
    | AntimirovArm => "Antimirov term sets"
    | EagerArm => "eager DFA"
    | MinimalArm => "minimal DFA (baseline A)"
    | MinimalAgainArm => "minimal DFA again (A/A)"
    | RegexCrateArm => "Rust regex crate 1.x (oracle and baseline B)"
    | TableArm => "minimal DFA as an array table"
    | BacktrackingArm => "textbook backtracking (continuations, greedy star)"
    | LazyArm => "lazy DFA (interned nodes, memoized steps)"
    | LazyStoreArm => "lazy DFA, array store (node x class table)"

:= spread_cells (s : bench_model::spread) : list markup::markup =
    [ markup::escape (milli_text s::middle); markup::escape (milli_text s::low ++# " - " ++# milli_text s::high) ]

:~ time_row (aa : time_verdict) (all : list (list sample)) (a : arm) : list markup::markup =
    := s = bench_model::spread_of (ratios a all)
    := name = markup::escape (arm_name a)
    ?= aa ?|
    | Ratio _ => name :: spread_cells s
    | Void v =>
        := void = markup::escape ("VOID (" ++# milli_text s::middle ++# " unverified)")
        [ name; void; markup::escape ("A/A " ++# milli_text v::middle ++# ", outside 0.95-1.05") ]

:~ ^ counts_agree (all : list (list sample)) (count : i32) : bool =
    ?= all ?|
    | round :: rest => listm::forall' (\ (s : sample) => s::count = count) round && counts_agree rest count
    | [] => !+

:== report = { html : markup::markup; failures : i32 }

:= size_text (s : size) : string =
    ?= s ?|
    | States n => sm'::obj_to_string n ++# " states"
    | Refused n => "refused at " ++# sm'::obj_to_string n

:| certification =
    | Checked : check
    | TooLarge : i32

:= certification_of (m : dfa) : certification =
    := n = state_count m
    ? n <= 128i32 ?> Checked (check_minimality m (certify m)) |: TooLarge n

:= check_ok (c : check) : bool =
    ?= c ?|
    | Certified _ => !+
    | _ => !-

:= certification_ok (c : certification) : bool =
    ?= c ?|
    | Checked k => check_ok k
    | TooLarge _ => !+
:= check_text (c : check) : string =
    ?= c ?|
    | Certified n => "certified, " ++# sm'::obj_to_string n ++# " pairs"
    | Forged _ => "FORGED"
    | Uncertified _ => "NOT MINIMAL"

:= agreement_text (a : agreement) : string =
    ?= a ?|
    | Agree n => "agree on " ++# sm'::obj_to_string n ++# " words"
    | Disagree _ => "DISAGREE"

:= certification_text (c : certification) : string =
    ?= c ?|
    | Checked k => check_text k
    | TooLarge n => "certificate skipped at " ++# sm'::obj_to_string n ++# " states"

:= deterministic_ok (w : workload) (p : prepared) (c : certification) (a : agreement) : bool =
    := minimal_ok = (minimal_size p::eager = expected_minimal w)
    := certified = certification_ok c
    := agreed = ?= a ?| Agree _ => !+ | _ => !-
    minimal_ok && certified && agreed

:== facts = { name : string; prepared : prepared; certification : certification; agreement : agreement; ok : bool }

:= facts_head (f : facts) : markup::markup =
    := sizes =
        size_text (size_of f::prepared::eager)
        ++# " built, "
        ++# size_text (minimal_size f::prepared::eager)
        ++# " minimal"
    := checks = "; " ++# certification_text f::certification ++# "; " ++# agreement_text f::agreement
    := line = sizes ++# checks ++# (? f::ok ?> "" |: "; MISMATCH")
    markup::joined (markup::element "h2" [] (markup::escape f::name)) (markup::element "p" [] (markup::escape line))

:= time_table (aa : time_verdict) (all : list (list sample)) : markup::markup =
    := header = listm::map markup::escape [ "arm"; "median time / baseline A"; "IQR" ]
    markup::table header (listm::map (time_row aa all) (all_arms ()))

:~ ^ setups (r : re) (left : i32) (dead : i32) : i32 =
    ? left <= 0i32
    ?> dead
    |:
        := t = table_of (certified_of r)
        setups r (left - 1i32) (dead + t::dead)

:~ setup_ms (r : re) : f64 =
    := before = date_time.monotonic_nanoseconds ()
    := dead = setups r 25i32 0i32
    := spent = date_time.monotonic_nanoseconds () - before
    ? dead < 0i32 ?> 0.0 |: (conv spent : f64) / 25000000.0

:~ ^ table_pass_ms (all : list (list sample)) : list f64 =
    ?= all ?|
    | round :: rest =>
        := s = sample_of TableArm round
        ((conv s::nanos : f64) / 25000000.0) :: table_pass_ms rest
    | [] => []

:~ timed_text (ms : f64) : string =
    := u = bench_model::unit_of ms
    milli_text (bench_model::in_unit u ms) ++# " " ++# bench_model::unit_name u

:~ setup_line (r : re) (all : list (list sample)) : markup::markup =
    := build = "setup " ++# timed_text (setup_ms r) ++# " per certified table build (mean of 25)"
    := passes = bench_model::spread_of (table_pass_ms all)
    := pass = ", one array table pass " ++# timed_text passes::middle ++# " (median)"
    markup::element "p" [] (markup::escape (build ++# pass))

:~ facts_of (salt : u32) (w : workload) (p : prepared) (all : list (list sample)) : facts =
    := c = certification_of p::quotient
    := a = agreement_on salt 40u32 p::regex
    := ok = deterministic_ok w p c a && counts_agree all (accepted MinimalArm p p::words 0i32)
    { name = workload_name w; prepared = p; certification = c; agreement = a; ok = ok }

:~ workload_report (salt : u32) (w : workload) : report =
    := p = prepare salt 400u32 w
    := all = rounds p 0i32 15i32 []
    := f = facts_of salt w p all
    := table = time_table (aa_band (bench_model::spread_of (ratios MinimalAgainArm all))) all
    := html = markup::concat [ facts_head f; setup_line p::regex all; table ]
    { html = html; failures = ? f::ok ?> 0i32 |: 1i32 }
:~ ^ all_reports (salt : u32) (ws : list workload) (acc : report) : report =
    ?= ws ?|
    | w :: rest =>
        := r = workload_report salt w
        all_reports salt rest { html = markup::joined acc::html r::html; failures = acc::failures + r::failures }
    | [] => acc

:= stamp () : markup::markup =
    := runner =
        "commit " ++# env_text "GITHUB_SHA" ++# ", runner " ++# env_text "RUNNER_OS" ++# " " ++# env_text "RUNNER_ARCH"
    := method =
        ", seed 20261101, 15 rounds, 400 words x 25 passes per arm and round, arms rotated every round, wall time "
        ^^ "(Instant)"
    markup::element "p" [] (markup::escape (runner ++# method))

:~ ^ module_text (lines : list string) : string =
    ?= lines ?|
    | [] => ""
    | [ last ] => last
    | line :: rest => line ++# "\n\n" ++# module_text rest

:= staged_header () : string =
    "///- --package . --timeout 900000\n:# staged_tables static =\n    :< testing\n\n:< regex_table\n:< table_emit\n\n"

:~ staged_lines (k : i32) (w : workload) : list string = table_lines ("s" ++# sm'::show k ++# "_") (minimal_table (workload_regex w))

:~ staged_all () : list string =
    := small = listm::append (staged_lines 1i32 EndsInZero) (listm::append (staged_lines 2i32 ZeroRuns) (staged_lines 3i32 FourthFromEnd))
    listm::append small (listm::append (staged_lines 4i32 CountedLetters) (staged_lines 5i32 EighthFromEnd))

:~ emit_staged () : i32 =
    print_line (staged_header () ++# module_text (staged_all ()))
    0i32

:~ run_bench () : i32 =
    := ~salt = 20261101u32
    := ws = [ EndsInZero; ZeroRuns; FourthFromEnd; CountedLetters; FourthFromEndLong; EighthFromEnd ]
    := r = all_reports salt ws { html = markup::trusted ""; failures = 0i32 }
    := body = markup::concat [ markup::element "h1" [] (markup::escape "regex benchmarks"); stamp (); r::html ]
    markup::document "regex benchmarks" (markup::trusted "") body |> markup::markup_text |> print_line
    r::failures

:= main () : i32 = ? env_text "REGEX_EMIT_STAGED" <> "" ?> emit_staged () |: run_bench ()
