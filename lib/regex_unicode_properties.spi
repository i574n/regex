:~ ^ key_from (codes : list i32) (acc : list u32) : list u32 =
    ?= codes ?|
    | c :: rest =>
        := u : u32 = conv c
        ? u = 32u32 || u = 95u32 || u = 45u32
        ?> key_from rest acc
        |? 65u32 <= u && u <= 90u32
        ?> key_from rest ((u + 32u32) :: acc)
        |: key_from rest (u :: acc)
    | [] => listm::rev acc

:~ key_of (s : string) : list u32 = key_from (unicode::code_points s) []

:~ loose_key (codes : list u32) : list u32 = key_from (codes |> listm::map (\ (c : u32) => (conv c : i32))) []

:~ named (key : list u32) (names : list string) : bool =
    names |> listm::fold (\ (hit : bool) (n : string) => hit || key = key_of n) !-

:~ category_table (key : list u32) : option (string * string) =
    ? named key [ "l"; "letter" ]
    ?> Some (letter_lows (), letter_highs ())
    |? named key [ "lu"; "uppercaseletter" ]
    ?> Some (uppercase_letter_lows (), uppercase_letter_highs ())
    |? named key [ "ll"; "lowercaseletter" ]
    ?> Some (lowercase_letter_lows (), lowercase_letter_highs ())
    |? named key [ "lt"; "titlecaseletter" ]
    ?> Some (titlecase_letter_lows (), titlecase_letter_highs ())
    |? named key [ "lm"; "modifierletter" ]
    ?> Some (modifier_letter_lows (), modifier_letter_highs ())
    |? named key [ "lo"; "otherletter" ]
    ?> Some (other_letter_lows (), other_letter_highs ())
    |? named key [ "m"; "mark"; "combiningmark" ]
    ?> Some (mark_lows (), mark_highs ())
    |? named key [ "n"; "number" ]
    ?> Some (number_lows (), number_highs ())
    |? named key [ "nd"; "decimalnumber"; "digit" ]
    ?> Some (decimal_number_lows (), decimal_number_highs ())
    |? named key [ "nl"; "letternumber" ]
    ?> Some (letter_number_lows (), letter_number_highs ())
    |? named key [ "no"; "othernumber" ]
    ?> Some (other_number_lows (), other_number_highs ())
    |? named key [ "p"; "punctuation"; "punct" ]
    ?> Some (punctuation_lows (), punctuation_highs ())
    |? named key [ "s"; "symbol" ]
    ?> Some (symbol_lows (), symbol_highs ())
    |? named key [ "z"; "separator" ]
    ?> Some (separator_lows (), separator_highs ())
    |? named key [ "cc"; "control"; "cntrl" ]
    ?> Some ("0,127", "31,159")
    |: None

:~ script_table (key : list u32) : option (string * string) =
    ? named key [ "latin"; "latn" ]
    ?> Some (latin_lows (), latin_highs ())
    |? named key [ "greek"; "grek" ]
    ?> Some (greek_lows (), greek_highs ())
    |? named key [ "cyrillic"; "cyrl" ]
    ?> Some (cyrillic_lows (), cyrillic_highs ())
    |? named key [ "han"; "hani" ]
    ?> Some (han_lows (), han_highs ())
    |? named key [ "arabic"; "arab" ]
    ?> Some (arabic_lows (), arabic_highs ())
    |? named key [ "hebrew"; "hebr" ]
    ?> Some (hebrew_lows (), hebrew_highs ())
    |: None

:~ either_table (key : list u32) : option (string * string) =
    ?= category_table key ?|
    | Some found => Some found
    | None => script_table key

:~ ^ split_at_equals (codes : list u32) (before : list u32) : option (list u32 * list u32) =
    ?= codes ?|
    | c :: rest => ? c = 61u32 || c = 58u32 ?> Some (listm::rev before, rest) |: split_at_equals rest (c :: before)
    | [] => None

:~ prefixed_table (prefix : list u32) (value : list u32) : option (string * string) =
    ? named prefix [ "gc"; "generalcategory" ]
    ?> category_table value
    |? named prefix [ "sc"; "script" ]
    ?> script_table value
    |: None

:~ property_set (name : list u32) : option (char_set normal) =
    := found =
        ?= split_at_equals name [] ?|
        | Some (prefix, value) => prefixed_table (loose_key prefix) (loose_key value)
        | None => either_table (loose_key name)
    ?= found ?|
    | Some (lows, highs) => Some (table_set lows highs)
    | None => None

:~ property_size (name : string) : i32 =
    ?= property_set (key_of name) ?|
    | Some s => (listm::length (ranges_of s) : i32)
    | None => -1i32

///> rust
///> gleam
:# property_names_resolve_loosely_and_unknown_ones_are_absent =
    (
        [ property_size "L"; property_size "Lu"; property_size "uppercase_letter"; property_size "gc=Nd" ],
        [ property_size "Greek"; property_size "Script=GREEK"; property_size "sc=Han"; property_size "Cc" ],
        [ property_size "Klingon"; property_size "scx=Greek"; property_size "Any" ]
    )
    |> _assert_eq ([ 677i32; 651i32; 651i32; 71i32 ], [ 36i32; 36i32; 22i32; 2i32 ], [ -1i32; -1i32; -1i32 ])
