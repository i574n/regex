///- --package .
:# regex_utf8 static =
    :< testing

:== byte_range = { low : u32; high : u32 }

:== sequence = list byte_range

:~ continuation (c : u32) (shift : i32) : u32 = 128u32 ||| ((c >>> shift) &&& 63u32)

:= encode (c : u32) : list u32 =
    ? c <= 127u32
    ?> [ c ]
    |? c <= 2047u32
    ?> [ 192u32 ||| (c >>> 6i32); continuation c 0i32 ]
    |? c <= 65535u32
    ?> [ 224u32 ||| (c >>> 12i32); continuation c 6i32; continuation c 0i32 ]
    |: [ 240u32 ||| (c >>> 18i32); continuation c 12i32; continuation c 6i32; continuation c 0i32 ]

:~ ^ zipped (lows : list u32) (highs : list u32) (acc : sequence) : sequence =
    ?= lows, highs ?|
    | (l :: ls), (h :: hs) => zipped ls hs ({ low = l; high = h } :: acc)
    | _ => listm::rev acc

:~ ^ boundary_split (s : u32) (e : u32) (bounds : list u32) : option (u32 * u32 * u32 * u32) =
    ?= bounds ?|
    | b :: rest => ? s <= b && e > b ?> Some (s, b, b + 1u32, e) |: boundary_split s e rest
    | [] => None

:~ ^ bit_split (s : u32) (e : u32) (i : i32) : option (u32 * u32 * u32 * u32) =
    ? i > 3i32
    ?> None
    |:
        := shift = 6i32 * i
        := m = (1u32 <<< shift) - 1u32
        ? (s >>> shift) <> (e >>> shift)
        ?>
            ? (s &&& m) <> 0u32
            ?> Some (s, s ||| m, (s ||| m) + 1u32, e)
            |? (e &&& m) <> m
            ?> Some (s, e - (e &&& m) - 1u32, e - (e &&& m), e)
            |: bit_split s e (i + 1i32)
        |: bit_split s e (i + 1i32)

:~ ^ sequences_from (todo : list (u32 * u32)) (acc : list sequence) : list sequence =
    ?= todo ?|
    | (s, e) :: rest =>
        ? s > e
        ?> sequences_from rest acc
        |? s <= 57343u32 && e >= 55296u32
        ?> sequences_from ((s, 55295u32) :: (57344u32, e) :: rest) acc
        |:
            ?= boundary_split s e [ 127u32; 2047u32; 65535u32 ] ?|
            | Some (a, b, c, d) => sequences_from ((a, b) :: (c, d) :: rest) acc
            | None =>
                ? e <= 127u32
                ?> sequences_from rest ([ { low = s; high = e } ] :: acc)
                |:
                    ?= bit_split s e 1i32 ?|
                    | Some (a, b, c, d) => sequences_from ((a, b) :: (c, d) :: rest) acc
                    | None => sequences_from rest (zipped (encode s) (encode e) [] :: acc)
    | [] => listm::rev acc

:= utf8_sequences (low : u32) (high : u32) : list sequence = sequences_from [ (low, high) ] []

:~ ^ fits (bytes : list u32) (seq : sequence) : bool =
    ?= bytes, seq ?|
    | (b :: bs), (r :: rs) => b >= r::low && b <= r::high && fits bs rs
    | [], [] => !+
    | _ => !-

:~ ^ hits (bytes : list u32) (seqs : list sequence) (n : i32) : i32 =
    ?= seqs ?|
    | q :: rest => hits bytes rest (? fits bytes q ?> n + 1i32 |: n)
    | [] => n

:~ is_surrogate (c : u32) : bool = c >= 55296u32 && c <= 57343u32

:~ ^ coverage_faults (seqs : list sequence) (c : u32) (stop : u32) (step : u32) (faults : i32) : i32 =
    ? c > stop
    ?> faults
    |:
        := wanted = ? is_surrogate c ?> 0i32 |: 1i32
        coverage_faults seqs (c + step) stop step (? hits (encode c) seqs 0i32 = wanted ?> faults |: faults + 1i32)

:= range_faults (low : u32) (high : u32) (step : u32) : i32 =
    := seqs = utf8_sequences low high
    := inside = coverage_faults seqs low high step 0i32
    := below = ? low = 0u32 ?> 0i32 |: hits (encode (low - 1u32)) seqs 0i32
    := above = ? high >= 1114111u32 ?> 0i32 |: hits (encode (high + 1u32)) seqs 0i32
    inside + below + above

:= sequence_text (seq : sequence) : list (u32 * u32) = listm::map (\ (r : byte_range) => r::low, r::high) seq

///> rust
:# all_of_unicode_compiles_to_the_nine_well_known_byte_sequences =
    listm::map sequence_text (utf8_sequences 0u32 1114111u32)
    |> _assert_eq [
        [ (0u32, 127u32) ]
        [ (194u32, 223u32); (128u32, 191u32) ]
        [ (224u32, 224u32); (160u32, 191u32); (128u32, 191u32) ]
        [ (225u32, 236u32); (128u32, 191u32); (128u32, 191u32) ]
        [ (237u32, 237u32); (128u32, 159u32); (128u32, 191u32) ]
        [ (238u32, 239u32); (128u32, 191u32); (128u32, 191u32) ]
        [ (240u32, 240u32); (144u32, 191u32); (128u32, 191u32); (128u32, 191u32) ]
        [ (241u32, 243u32); (128u32, 191u32); (128u32, 191u32); (128u32, 191u32) ]
        [ (244u32, 244u32); (128u32, 143u32); (128u32, 191u32); (128u32, 191u32) ]
    ]

///> rust
:# every_97th_code_point_of_unicode_encodes_into_exactly_one_sequence_and_surrogates_into_none =
    range_faults 0u32 1114111u32 97u32 |> _assert_eq 0i32

///> rust
:# ranges_that_cross_length_and_surrogate_boundaries_cover_exactly_their_code_points =
    [ (880u32, 1023u32); (127u32, 128u32); (53248u32, 57600u32); (2000u32, 70000u32); (65u32, 90u32) ]
    |> listm::map (\ ((l, h) : u32 * u32) => range_faults l h 1u32)
    |> _assert_eq [ 0i32; 0i32; 0i32; 0i32; 0i32 ]

///> rust
:# the_encoder_matches_the_standard_byte_patterns =
    (encode 65u32, encode 233u32, encode 8364u32, encode 128512u32)
    |> _assert_eq ([ 65u32 ], [ 195u32; 169u32 ], [ 226u32; 130u32; 172u32 ], [ 240u32; 159u32; 152u32; 128u32 ])
